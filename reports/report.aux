\newlabel{fig:phase3asnr}{{7}{15}{Phase~3a BLER vs.\ SNR at INR~$=5$~dB. S1-oracle (searched trellis + oracle Viterbi) tracks B2 (NASA~K=7 + oracle Viterbi) within statistical noise across the full SNR range, confirming that the EA found a trellis with equivalent oracle-decoding performance to the classical K=7 code}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Phase~3a BLER vs.\ INR at SNR~$=5$~dB. S1-oracle (searched trellis + oracle Viterbi) is invariant to INR, as expected when interference is perfectly subtracted before decoding.}}{15}{figure.caption.20}\protected@file@percent }
\newlabel{fig:phase3ainr}{{8}{15}{Phase~3a BLER vs.\ INR at SNR~$=5$~dB. S1-oracle (searched trellis + oracle Viterbi) is invariant to INR, as expected when interference is perfectly subtracted before decoding}{figure.caption.20}{}}
